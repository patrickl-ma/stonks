{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-17",
  "dev": {
    "port": 3001
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "ca323f1618ba47e3905c8f02b7d88776",
      "localConnectionString": "postgresql://stonks:stonks@localhost:55432/stonks"
    }
  ],
  "vars": {
    "BETTER_AUTH_URL": "http://localhost:3001",
    "SPA_ORIGIN": "http://localhost:5173"
  },

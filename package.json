{
  "name": "stonks",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "pnpm --filter apps/web dev",
    "dev:api": "pnpm --filter packages/api dev",
    "dev": "concurrently \"pnpm --filter packages/api dev\" \"pnpm --filter apps/web dev\"",
    "build": "pnpm -w -r run build",
    "start:api": "node packages/api/dist/index.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}
